#include <a_samp>
#include <streamer>

public OnFilterScriptExit() {
    for(new i; i < MAX_PLAYERS; i++) {
	    if(GetPlayerVirtualWorld(i) != 0 || GetPlayerInterior(i) != 0) {
			TogglePlayerControllable(i, false);
		}
	}
}

public OnFilterScriptInit() {

    for(new i; i < MAX_PLAYERS; i++) {
	    if(GetPlayerVirtualWorld(i) != 0 || GetPlayerInterior(i) != 0) {
			TogglePlayerControllable(i, false);
		}
	}
